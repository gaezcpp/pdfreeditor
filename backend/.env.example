# Copy to .env and adjust. Never commit the real .env.

ENVIRONMENT=development
DEBUG=true

# --- Security ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-please-this-is-not-safe-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database ----------------------------------------------------------------
# Docker Compose (recommended) always uses the `db` service, so this URL is
# only for runs outside Docker. SQLite needs no server and runs the whole app
# locally; switch to the PostgreSQL line for a local prod-like run.
DATABASE_URL=sqlite+aiosqlite:///var/dev.db
# DATABASE_URL=postgresql+asyncpg://pdfree:pdfree@localhost:5432/pdfree

# --- Docker Compose ----------------------------------------------------------
# Credentials for the `db` (PostgreSQL) service. Change the password for
# anything beyond local development.
POSTGRES_USER=pdfree
POSTGRES_PASSWORD=pdfree
POSTGRES_DB=pdfree
# Host port for the API.
PORT=8000

# --- Quota -------------------------------------------------------------------
FREE_WEEKLY_EDIT_QUOTA=5

# --- Uploads -----------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=500
MAX_MERGE_FILES=10
TEMP_DIR=var/tmp

# --- Web app -----------------------------------------------------------------
# Serve the built Flutter web app (../build/web) at the site root, so the page
# and the API share one origin. Set to false to run API-only.
SERVE_WEB_APP=true

# --- CORS (comma separated, "*" allows all — dev only) -----------------------
CORS_ORIGINS=*
ADMIN_CONTACT_URL=mailto:admin@example.com
ADMIN_EMAIL=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
PASSWORD_RESET_EXPIRE_MINUTES=30
# Configure SMTP before exposing password reset to real users.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
