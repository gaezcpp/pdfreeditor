# Copy to .env and adjust. Never commit the real .env.

ENVIRONMENT=development
DEBUG=true

# --- Security ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-please-this-is-not-safe-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database ----------------------------------------------------------------
# SQLite needs no server and runs the whole app locally. Switch to the
# PostgreSQL line for production — same schema, same migrations.
DATABASE_URL=sqlite+aiosqlite:///var/dev.db
# DATABASE_URL=postgresql+asyncpg://pdfree:pdfree@localhost:5432/pdfree

# --- Quota -------------------------------------------------------------------
FREE_WEEKLY_EDIT_QUOTA=5

# --- Uploads -----------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=500
MAX_MERGE_FILES=10
TEMP_DIR=var/tmp

# --- Web app -----------------------------------------------------------------
# Serve the built Flutter web app (../build/web) at the site root, so the page
# and the API share one origin. Set to false to run API-only.
SERVE_WEB_APP=true

# --- CORS (comma separated, "*" allows all — dev only) -----------------------
CORS_ORIGINS=*
